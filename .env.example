# AMD Developer Cloud — TWO separate vLLM endpoints, one per model
AMD_FAST_MODEL_URL=          # vLLM endpoint serving Qwen2.5-Coder-7B-Instruct
AMD_DEEP_MODEL_URL=          # vLLM endpoint serving Qwen2.5-Coder-32B-Instruct
AMD_API_KEY=                 # AMD Developer Cloud API key

# Model identifiers
FAST_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
DEEP_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Rust Engine
RUST_ENGINE_URL=http://rust-engine:3000
RUST_ENGINE_MAX_SLOTS=25
RUST_ENGINE_CHANNEL_DEPTH=20
RUST_ENGINE_FANOUT_TIMEOUT_MS=8000   # max wait for both models

# Pipeline
PIPELINE_URL=http://pipeline:8000
PIPELINE_RATE_LIMIT_PER_MIN=20
PIPELINE_MAX_FILE_SIZE_MB=10
PIPELINE_TIMEOUT_S=300

# GitHub
GITHUB_TOKEN=                # personal access token, repo + PR scope

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
VECTOR_TABLE=parallax_embeddings

# Frontend
NEXT_PUBLIC_PIPELINE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Parallax

# Observability
PROMETHEUS_PORT=9090
